---
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, useTranslations } from '@/i18n/ui'
import { mdiChevronLeft, mdiChevronRight } from '@/lib/icons'

interface Props {
  lang?: Lang
  currentPage: number
  totalPages: number
  baseUrl: string
}

const { lang = defaultLang, currentPage, totalPages, baseUrl } = Astro.props
const t = useTranslations(lang)

function pageUrl(page: number): string {
  const base = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl
  return page <= 1 ? `${base}/` : `${base}/${page}/`
}

function pages(): (number | '...')[] {
  const n = totalPages
  const c = currentPage
  const s = 1
  if (n <= 5 + s * 2) return Array.from({ length: n }, (_, i) => i + 1)
  const out: (number | '...')[] = [1]
  if (c > s + 2) out.push('...')
  for (let i = Math.max(2, c - s); i <= Math.min(n - 1, c + s); i++) out.push(i)
  if (c < n - s - 1) out.push('...')
  out.push(n)
  return out
}
---

{
  totalPages > 1 && (
    <div class="mt-5 flex items-center justify-center gap-1 text-sm">
      {currentPage <= 1 ? (
        <span
          class="pg-btn pg-nav pg-disabled inline-flex h-8 min-w-8 items-center justify-center rounded px-2"
          aria-disabled="true"
          aria-label={t('pagination.prev')}
        >
          <Icon d={mdiChevronLeft} />
        </span>
      ) : (
        <a
          href={pageUrl(currentPage - 1)}
          class="pg-btn pg-nav inline-flex h-8 min-w-8 items-center justify-center rounded px-2"
          aria-label={t('pagination.prev')}
        >
          <Icon d={mdiChevronLeft} />
        </a>
      )}
      {pages().map((item) =>
        item === '...' ? (
          <span class="inline-flex h-8 min-w-8 items-center justify-center text-ink-3">…</span>
        ) : (
          <a
            href={pageUrl(item)}
            class:list={[
              'pg-btn pg-num inline-flex h-8 min-w-8 items-center justify-center rounded px-2',
              item === currentPage && 'pg-num-active',
            ]}
          >
            {item}
          </a>
        ),
      )}
      {currentPage >= totalPages ? (
        <button
          type="button"
          class="pg-btn pg-nav pg-disabled inline-flex h-8 min-w-8 items-center justify-center rounded px-2"
          disabled
          aria-label={t('pagination.next')}
        >
          <Icon d={mdiChevronRight} />
        </button>
      ) : (
        <a
          href={pageUrl(currentPage + 1)}
          class="pg-btn pg-nav inline-flex h-8 min-w-8 items-center justify-center rounded px-2"
          aria-label={t('pagination.next')}
        >
          <Icon d={mdiChevronRight} />
        </a>
      )}
    </div>
  )
}

<style>
  .pg-btn {
    border: none;
    font: inherit;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .pg-nav {
    background: var(--wp-text);
    color: var(--wp-bg);
  }
  a.pg-nav:hover {
    background: var(--wp-accent);
    color: #ffffff;
    transform: scale(1.05);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--wp-accent) 40%, transparent);
  }
  .pg-disabled {
    cursor: not-allowed;
  }
  .pg-num {
    border: 1px solid var(--wp-border);
    background: var(--wp-bg);
    color: var(--wp-text);
  }
  .pg-num:hover {
    border-color: var(--wp-accent);
    background: var(--wp-accent);
    color: #ffffff;
    transform: scale(1.05);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--wp-accent) 40%, transparent);
  }
  .pg-num-active {
    border-color: var(--wp-accent);
    background: var(--wp-accent);
    color: #ffffff;
    font-weight: 600;
  }
</style>
